# Base de données (SQLite en local, Postgres en prod)
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions (32+ caractères aléatoires)
AUTH_SECRET="change-moi-avec-openssl-rand-base64-32"

# Clé API Anthropic — le directeur créatif
ANTHROPIC_API_KEY=""

# Stripe (optionnel : sans ces clés l'app tourne en mode démo)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_STUDIO=""
STRIPE_PRICE_AGENCY=""

# URL publique de l'app (utilisée pour les redirections Stripe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
